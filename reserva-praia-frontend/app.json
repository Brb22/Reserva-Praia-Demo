{
  "expo": {
    "name": "Reserva Praia",
    "slug": "reserva-praia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reservapraia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bruno.reservapraia",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bruno.reservapraia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7E7CE"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png",
      "themeColor": "#F7E7CE",
      "backgroundColor": "#F7E7CE",
      "manifest": {
        "name": "Reserva Praia",
        "short_name": "Reserva Praia",
        "description": "Gerenciamento de reservas - Vila Caiçara, Praia Grande",
        "display": "standalone",
        "orientation": "portrait",
        "background_color": "#F7E7CE",
        "theme_color": "#5D4037",
        "icons": [
          {
            "src": "./assets/images/icon.png",
            "sizes": "192x192",
            "type": "image/png"
          },
          {
            "src": "./assets/images/icon.png",
            "sizes": "512x512",
            "type": "image/png"
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7E7CE"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dfcfb741-37fb-4541-b35c-4edc54df7827"
      }
    }
  }
}
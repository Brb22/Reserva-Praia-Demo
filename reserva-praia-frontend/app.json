{
  "expo": {
    "name": "Reserva Praia",
    "slug": "reserva-praia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reservapraia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bruno.reservapraia"
    },
    "android": {
      "package": "com.bruno.reservapraia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7E7CE"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7E7CE"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dfcfb741-37fb-4541-b35c-4edc54df7827"
      }
    }
  }
}
